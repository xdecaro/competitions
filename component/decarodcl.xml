<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>COM_DECARODCL</name>
  <author>Luca De Caro</author>
  <creationDate>2026-09</creationDate>
  <copyright>Copyright (C) 2026 Luca De Caro. All rights reserved.</copyright>
  <license>GNU General Public License version 2 or later</license>
  <authorUrl>https://github.com/xdecaro/dcl</authorUrl>
  <version>0.8.1</version>
  <description>COM_DECARODCL_XML_DESCRIPTION</description>
  <targetplatform name="joomla" version="6.*" />
  <namespace path="src">Xdecaro\Component\Decarodcl</namespace>
  <scriptfile>script.php</scriptfile>

  <files folder="site">
    <folder>src</folder>
  </files>

  <administration>
    <menu>COM_DECARODCL</menu>
    <submenu>
      <menu view="dashboard">COM_DECARODCL_DASHBOARD</menu>
      <menu view="organizations">COM_DECARODCL_ORGANIZATIONS</menu>
      <menu view="zones">COM_DECARODCL_ZONES</menu>
      <menu view="countries">COM_DECARODCL_COUNTRIES</menu>
      <menu view="federations">COM_DECARODCL_FEDERATIONS</menu>
      <menu view="tournaments">COM_DECARODCL_TOURNAMENTS</menu>
      <menu view="seasons">COM_DECARODCL_SEASONS</menu>
      <menu view="teams">COM_DECARODCL_TEAMS</menu>
      <menu view="participations">COM_DECARODCL_PARTICIPATIONS</menu>
      <menu view="players">COM_DECARODCL_PLAYERS</menu>
      <menu view="rosters">COM_DECARODCL_ROSTERS</menu>
      <menu view="matches">COM_DECARODCL_MATCHES</menu>
      <menu view="information">COM_DECARODCL_INFORMATION</menu>
    </submenu>
    <files folder="admin">
      <filename>access.xml</filename>
      <filename>config.xml</filename>
      <folder>forms</folder>
      <folder>services</folder>
      <folder>sql</folder>
      <folder>src</folder>
      <folder>tmpl</folder>
    </files>
    <languages folder="admin/language">
      <language tag="en-GB">en-GB/com_decarodcl.ini</language>
      <language tag="en-GB">en-GB/com_decarodcl.070.ini</language>
      <language tag="en-GB">en-GB/com_decarodcl.071.ini</language>
      <language tag="en-GB">en-GB/com_decarodcl.080.ini</language>
      <language tag="en-GB">en-GB/com_decarodcl.sys.ini</language>
      <language tag="it-IT">it-IT/com_decarodcl.ini</language>
      <language tag="it-IT">it-IT/com_decarodcl.070.ini</language>
      <language tag="it-IT">it-IT/com_decarodcl.071.ini</language>
      <language tag="it-IT">it-IT/com_decarodcl.080.ini</language>
      <language tag="it-IT">it-IT/com_decarodcl.sys.ini</language>
    </languages>
  </administration>

  <media destination="com_decarodcl" folder="media">
    <filename>joomla.asset.json</filename>
    <filename>admin.css</filename>
    <folder>css</folder>
  </media>

  <install>
    <sql>
      <file driver="mysql" charset="utf8mb4">sql/install.mysql.utf8mb4.sql</file>
      <file driver="mysql" charset="utf8mb4">sql/install.0.7.mysql.utf8mb4.sql</file>
      <file driver="mysql" charset="utf8mb4">sql/install.0.8.mysql.utf8mb4.sql</file>
    </sql>
  </install>

  <uninstall>
    <sql>
      <file driver="mysql" charset="utf8mb4">sql/uninstall.mysql.utf8mb4.sql</file>
    </sql>
  </uninstall>

  <update>
    <schemas>
      <schemapath type="mysql">sql/updates/mysql</schemapath>
    </schemas>
  </update>
</extension>
