<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset name="details" label="COM_XDECAROCOMPETITIONS_TEAM_DETAILS">
    <field name="id" type="hidden" />
    <field name="modified" type="hidden" />
    <field name="name" type="text" label="COM_XDECAROCOMPETITIONS_FIELD_NAME" required="true" maxlength="190" />
    <field name="short_name" type="text" label="COM_XDECAROCOMPETITIONS_FIELD_SHORT_NAME" maxlength="100" />
    <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="COM_XDECAROCOMPETITIONS_TEAM_ALIAS_DESC" maxlength="190" />
    <field
      name="federation_id"
      type="sql"
      label="COM_XDECAROCOMPETITIONS_FIELD_FEDERATION"
      required="true"
      query="SELECT f.id AS value, CONCAT(f.name, ' — ', c.name, ' (', c.code, ')') AS text FROM #__xdecarocompetitions_federations AS f INNER JOIN #__xdecarocompetitions_countries AS c ON c.id = f.country_id WHERE f.state &lt;&gt; -2 AND c.state &lt;&gt; -2 ORDER BY c.name ASC, f.name ASC"
      key_field="value"
      value_field="text"
    />
    <field name="team_type" type="list" label="COM_XDECAROCOMPETITIONS_FIELD_TEAM_TYPE" default="club" required="true">
      <option value="club">COM_XDECAROCOMPETITIONS_TEAM_TYPE_CLUB</option>
      <option value="national">COM_XDECAROCOMPETITIONS_TEAM_TYPE_NATIONAL</option>
    </field>
    <field
      name="owner_user_id"
      type="user"
      label="COM_XDECAROCOMPETITIONS_FIELD_TEAM_MANAGER"
      description="COM_XDECAROCOMPETITIONS_FIELD_TEAM_MANAGER_DESC"
    />
    <field name="logo" type="media" label="COM_XDECAROCOMPETITIONS_FIELD_LOGO" types="images" />
    <field name="city" type="text" label="COM_XDECAROCOMPETITIONS_FIELD_CITY" maxlength="190" />
    <field name="email" type="email" label="COM_XDECAROCOMPETITIONS_FIELD_EMAIL" maxlength="190" filter="email" />
    <field name="phone" type="tel" label="COM_XDECAROCOMPETITIONS_FIELD_PHONE" maxlength="100" />
    <field name="website" type="url" label="COM_XDECAROCOMPETITIONS_FIELD_WEBSITE" maxlength="512" filter="url" />
    <field name="approval_status" type="list" label="COM_XDECAROCOMPETITIONS_FIELD_APPROVAL_STATUS" default="pending">
      <option value="pending">COM_XDECAROCOMPETITIONS_APPROVAL_PENDING</option>
      <option value="approved">COM_XDECAROCOMPETITIONS_APPROVAL_APPROVED</option>
      <option value="rejected">COM_XDECAROCOMPETITIONS_APPROVAL_REJECTED</option>
    </field>
    <field
      name="rejection_reason"
      type="textarea"
      label="COM_XDECAROCOMPETITIONS_FIELD_REJECTION_REASON"
      rows="4"
      filter="safehtml"
      showon="approval_status:rejected"
    />
    <field name="state" type="list" label="JSTATUS" default="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
    </field>
    <field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" min="0" />
  </fieldset>
</form>
