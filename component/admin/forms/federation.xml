<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="xdecaro\Component\Competitions\Administrator\Field">
  <fieldset name="details" label="COM_XDECAROCOMPETITIONS_FEDERATION_DETAILS">
    <field name="id" type="hidden" />
    <field name="modified" type="hidden" />
    <field
      name="organization_uuid"
      type="FederationOrganization"
      label="COM_XDECAROCOMPETITIONS_FIELD_ORGANIZATION_FEDERATION"
      description="COM_XDECAROCOMPETITIONS_FIELD_ORGANIZATION_FEDERATION_DESC"
    />
    <field
      name="country_id"
      type="sql"
      label="COM_XDECAROCOMPETITIONS_FIELD_COUNTRY"
      description="COM_XDECAROCOMPETITIONS_FIELD_FEDERATION_COUNTRY_DESC"
      required="true"
      query="SELECT id AS value, CONCAT(name, ' (', code, ')') AS text FROM #__xdecarocompetitions_countries WHERE state &lt;&gt; -2 ORDER BY name ASC"
      key_field="value"
      value_field="text"
    >
      <option value="">COM_XDECAROCOMPETITIONS_SELECT_COUNTRY</option>
    </field>
    <field name="name" type="text" label="COM_XDECAROCOMPETITIONS_FIELD_NAME" maxlength="190" />
    <field name="short_name" type="text" label="COM_XDECAROCOMPETITIONS_FIELD_SHORT_NAME" maxlength="100" />
    <field name="logo" type="media" label="COM_XDECAROCOMPETITIONS_FIELD_LOGO" types="images" />
    <field name="website" type="url" label="COM_XDECAROCOMPETITIONS_FIELD_WEBSITE" maxlength="512" filter="url" />
    <field name="email" type="email" label="COM_XDECAROCOMPETITIONS_FIELD_EMAIL" maxlength="190" filter="email" />
    <field name="state" type="list" label="JSTATUS" default="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
    </field>
    <field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" min="0" />
  </fieldset>
</form>
